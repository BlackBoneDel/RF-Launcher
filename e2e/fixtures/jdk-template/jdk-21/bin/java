#!/bin/sh
# Java fixture de E2E: NO es un JDK real. Simula el binario justo lo suficiente
# para que el pipeline real de Rust lo detecte, lo descargue, lo verifique por
# SHA-256, lo lance como proceso del SO y lo mate por PID.
if [ "$1" = "-version" ]; then
  echo 'openjdk version "21.0.0" 2026-10-28' >&2
  echo 'OpenJDK Runtime Environment (rf-launcher-e2e)' >&2
  exit 0
fi

if [ -n "${RF_LAUNCHER_E2E_PID_FILE:-}" ]; then
  echo "$$" > "$RF_LAUNCHER_E2E_PID_FILE"
fi

# Se mantiene vivo hasta que el comando killInstance envíe la señal real.
while :; do
  sleep 1
done
